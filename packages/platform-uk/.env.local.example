# NextAuth.js Configuration
# Generate a secure random string: openssl rand -base64 32
NEXTAUTH_SECRET=dev-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Synthetic proof defaults. Keep disabled unless explicitly rehearsing integrations.
ENABLE_FASTAPI_SYNTHESIS=false
ENABLE_MEDPLUM_SYNC=false
NEXT_PUBLIC_ENABLE_FASTAPI_SYNTHESIS=false

# FastAPI synthesis rehearsal (only used when ENABLE_FASTAPI_SYNTHESIS=true)
FASTAPI_SYNTHESIS_URL=http://localhost:8000/api/v1/synthesis

# Medplum rehearsal (only used when ENABLE_MEDPLUM_SYNC=true)
MEDPLUM_URL=http://localhost:8103/fhir/R4
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# Transcription (optional live mode via Deepgram; without this key the API returns a rehearsal transcript)
# For live transcription: npm install @deepgram/sdk && set DEEPGRAM_API_KEY
DEEPGRAM_API_KEY=

# Marketing chatbot (Ask Aksh Health) — Vercel AI Gateway, server-side only
# AI_GATEWAY_API_KEY=

# Storage adapter (default JSON proof store; set USE_POSTGRES=true for Neon Postgres)
AKSH_STORAGE_ADAPTER=json_file_repository
USE_POSTGRES=false
# Neon pooled connection (Aksh Health project, aws-eu-west-2) — copy from Neon console
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Clinical identity provider OAuth scaffold (no secrets in repo)
CLINICAL_OAUTH_ENABLED=false
CLINICAL_OAUTH_CLIENT_ID=
CLINICAL_OAUTH_CLIENT_SECRET=
CLINICAL_OAUTH_ISSUER=https://identity.example.clinical/oauth
CLINICAL_OAUTH_AUTHORIZATION_URL=
CLINICAL_OAUTH_TOKEN_URL=
CLINICAL_OAUTH_SCOPES=openid profile clinical_role
AKSH_AUTH_PROOF_MODE=true
