{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next-build/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-build-active/types/**/*.ts",
    ".next-dev-active/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".next-dev",
    ".next-build",
    ".next-dev-active",
    ".next-build-active",
    "components/review/ops-dashboard-sections 2.tsx",
    ".tmp-tests"
  ]
}
