# Aksh Health UK Platform — environment variables
# Copy to packages/platform-uk/.env.local for local development.
# NEVER commit .env.local or real secrets to git.

# --- Auth (NextAuth + Neon Postgres) ---
# NEXTAUTH_URL=https://0ne-health.vercel.app
# NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>
# AKSH_AUTH_PROOF_MODE=true
# CLINICAL_OAUTH_ENABLED=false
# CLINICAL_OAUTH_CLIENT_ID=
# CLINICAL_OAUTH_CLIENT_SECRET=
# CLINICAL_OAUTH_AUTHORIZATION_URL=
# CLINICAL_OAUTH_TOKEN_URL=

# Ensure auth tables exist: npm run auth:schema
# Users must create accounts via /signup — demo credentials were removed.

# E2E / smoke (optional — Playwright creates users via /api/auth/signup when DATABASE_URL is set)
# E2E_TEST_PASSWORD=E2eTestPass1!
# E2E_DATABASE_URL=postgresql://...@...neon.tech/neondb?sslmode=require
#   GitHub Actions secret only — locally use DATABASE_URL instead.
# Role dashboard smoke (after `npm run seed:demo-cohort -- --apply`, or any /signup accounts):
# SMOKE_BASE_URL=http://127.0.0.1:3000
# SMOKE_GP_EMAIL=gp01@demo.akshhealth.com
# SMOKE_GP_PASSWORD=
# SMOKE_NURSE_EMAIL=nurse01@demo.akshhealth.com
# SMOKE_NURSE_PASSWORD=
# SMOKE_PHARMACIST_EMAIL=pharmacist01@demo.akshhealth.com
# SMOKE_PHARMACIST_PASSWORD=
# SMOKE_ADMIN_EMAIL=admin01@demo.akshhealth.com
# SMOKE_ADMIN_PASSWORD=
# SMOKE_PATIENT_EMAIL=patient01@demo.akshhealth.com
# SMOKE_PATIENT_PASSWORD=
# SMOKE_ICS_EMAIL=ics01@demo.akshhealth.com
# SMOKE_ICS_PASSWORD=
# SMOKE_HOSPITAL_EMAIL=hospital01@demo.akshhealth.com
# SMOKE_HOSPITAL_PASSWORD=
# SMOKE_RESEARCHER_EMAIL=researcher01@demo.akshhealth.com
# SMOKE_RESEARCHER_PASSWORD=
# See docs/DEMO_LAUNCH_CREDENTIALS.md
# --- Local development (.env.local) ---
# DATABASE_URL=postgresql://...@...neon.tech/neondb?sslmode=require
# After setting DATABASE_URL, apply practices + consent_grants: npm run db:migrate:p1
# Use sslmode=require for Neon/Vercel production. Do not add channel_binding=require —
# it can trigger Node pg SSL warnings on serverless. Optional overrides:
# PGSSLMODE=disable          # local Docker Postgres only
# PGSSL_REJECT_UNAUTHORIZED=true  # stricter cert verification (default: false for managed Neon)
# USE_POSTGRES=false
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=<local-dev-secret>

# --- Optional seed scope ---
# AKSH_DATA_SCOPE=shared
# AKSH_PRACTICE_ID=practice-demo

# --- Unified app (packages/platform-uk) — marketing + platform on same origin ---
# NEXT_PUBLIC_PLATFORM_URL is no longer required; all routes are relative.
# NEXT_PUBLIC_AKSH_ACCESS_REQUEST_MOCK_FALLBACK=true  # show sample organisation enquiries when DB is empty
# NEXT_PUBLIC_AKSH_PILOT_MOCK_FALLBACK=true  # deprecated alias for ACCESS_REQUEST_MOCK_FALLBACK

# Neon project: Aksh Health (floral-salad-21467299)
# Run seed: cd packages/platform-uk && npm run data:seed:postgres

# --- Neo4j AuraDB (Phase 11 — ORACLE / GUARDIAN / ICS graph) ---
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=<aura-generated-password>
# NEO4J_DATABASE=neo4j  # optional — only needed for non-default database names (e.g. AuraDB Professional)
# Run seed: npm run data:seed:neo4j
# See docs/NEO4J_SETUP.md

# --- Transactional email (Resend or SMTP) ---
# RESEND_API_KEY=re_...
# EMAIL_FROM=Aksh Health <noreply@akshhealth.com>
# NEXT_PUBLIC_EMAIL_DELIVERY_MODE=resend_sandbox  # set when EMAIL_FROM uses @resend.dev (honest client UX)
# ACCESS_REQUEST_NOTIFY_EMAIL=team@akshhealth.com
# SKIP_EMAIL_SEND=true  # E2E/CI: skip send and auto-verify signup emails

# --- Optional error monitoring ---
# SENTRY_DSN=  # Optional. Structured errors log via lib/monitoring.ts; add @sentry/nextjs for full SDK

# --- Marketing chatbot (Ask Aksh Health) ---
# Uses Vercel AI Gateway (default provider in the AI SDK). Server-side only — never expose in NEXT_PUBLIC_*.
# AI_GATEWAY_API_KEY=  # Required locally. On Vercel, OIDC may authenticate without this key.
# Without a key (and off Vercel), /api/chat returns 503 and the widget points visitors to FAQ / Contact.
# Free-tier Gateway blocks some models (e.g. openai/gpt-5.4-mini). Default chat model is openai/gpt-4o-mini.
# CHAT_MODEL=openai/gpt-4o-mini
# Top up credits to use newer models: https://vercel.com/docs/ai-gateway

# --- Clinical LLM SYNTHESIS (HITL drafts only) ---
# ENABLE_LLM_SYNTHESIS=true   # default on when AI Gateway / Vercel is available; set false to force deterministic
# POST /api/agents/synthesis — never writes to EHR
# ENABLE_LLM_GUARDIAN=true    # same AI Gateway gate as SYNTHESIS; set false to force deterministic GUARDIAN
# POST /api/agents/guardian — never writes to EHR
# ENABLE_LLM_ORACLE=true      # same AI Gateway gate; set false to force deterministic ORACLE
# POST /api/agents/oracle — never writes to EHR
# ENABLE_LLM_DR_ASSIST=true   # same AI Gateway gate; set false to force deterministic Dr.Assist coding
# POST /api/agents/dr-assist — never writes to EHR

# --- Deepgram voice (optional) ---
# DEEPGRAM_API_KEY=
# Without the key, /api/transcribe returns a clearly labelled simulated transcript.

# --- Neo4j (optional graph) ---
# NEO4J_REQUIRED=false  # when false, unreachable Neo4j does not mark /api/health as degraded

# --- EMIS partner track (scaffold / N5 sandbox — no live write-back) ---
# ENABLE_EMIS_PARTNER_SANDBOX=false
# EMIS_PARTNER_CLIENT_ID=
# EMIS_PARTNER_CLIENT_SECRET=
# EMIS_PARTNER_TOKEN_URL=
# EMIS_PARTNER_FHIR_BASE_URL=
# Flag off (default) = sim path (ehr-writeback-sim). Flag on without creds = needs_partner.
# Presence of EMIS_PARTNER_* ≠ permission to flip liveEmis (N7 + signed go/no-go only).
# Smoke: npm run smoke:emis-partner · status: GET /api/integrations/emis-partner-sandbox
# Partner checklist: docs/PHASE2_PARTNER_CHECKLIST.md · GET /api/integrations/emis-partner-checklist

# --- Phase 2 modality connectors (names only — no live Fitbit without real OAuth) ---
# FITBIT_CLIENT_ID=
# FITBIT_CLIENT_SECRET=
# FITBIT_REDIRECT_URI=
# WEARABLE_IMPORT_BUCKET=
# LIFESTYLE_DIARY_WEBHOOK_SECRET=
# Without Fitbit keys, connectors report liveStream:false and use synthetic fixtures.
# Ingest: POST /api/precision-health/ingest · status: GET /api/precision-health/connectors

# --- Phase 3 advanced modality stubs (names only — no live omics/DICOM/weather without keys) ---
# OPENWEATHER_API_KEY=
# DICOM_META_IMPORT_BUCKET=
# OMICS_PANEL_IMPORT_BUCKET=
# FEDERATED_RESEARCH_ETHICS_APPROVED=false  # set true only after ethics artefact; still synthetic aggregates
# Twin sim: POST /api/precision-health/twin/simulate · GET /api/precision-health/twin/status
# Causal: POST /api/agents/causal · Federated: GET/POST /api/research/federated/jobs
# Pharma/payer read-only: GET /api/integrations/pharma-rwe · GET /api/integrations/payer-vbc
# Regulatory templates: docs/PHASE3_REGULATORY_PATH.md

# --- Medplum FHIR rehearsal (never EMIS) ---
# ENABLE_MEDPLUM_SYNC=false
# MEDPLUM_URL=http://localhost:8103/fhir/R4
# MEDPLUM_CLIENT_ID=
# MEDPLUM_CLIENT_SECRET=
# Dry-run: GET /api/integrations/medplum-status?probe=dry-run

# --- Diabetes disease intelligence module (B3, rules-based, HITL draft only) ---
# ENABLE_DIABETES_MODULE=false  # default off. When true, adds additive HORIZON/GUARDIAN
# contributions for diabetes-flagged (clinicalProfiles: "t2d") patients only. No AI Gateway
# call, no dose/prescribing output. Glucose Intelligence stays insufficient_data pending
# OQ-DIAB-1 (modality schema). See docs/DISEASE_INTELLIGENCE_DIABETES_SPEC.md, docs/PHASED_BUILD_PLAN.md B3.

# --- P2 optional CONDUCTOR after classic intake (evaluation only; default off) ---
# ENABLE_CONDUCTOR_FROM_INTAKE=false  # When true, POST /api/review-cases create may offer/run
# clinical-spine CONDUCTOR if orchestrateAfterIntake:true. Guardian gates intact; never
# auto-accepts; ehrWrite:false. Prefer explicit GP orchestrate panel for production paths.

# npm run auth:cleanup-demo
# npm run auth:cleanup-demo -- --apply
