# Aksh Health UK Platform — environment variables
# Copy to packages/platform-uk/.env.local for local development.
# NEVER commit .env.local or real secrets to git.

# --- Vercel (production / preview) ---
# DATABASE_URL=postgresql://...@...neon.tech/neondb?sslmode=require
# USE_POSTGRES=true
# NEXTAUTH_URL=https://0ne-health.vercel.app
# NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>

# --- Local development (.env.local) ---
# DATABASE_URL=postgresql://...@...neon.tech/neondb?sslmode=require
# USE_POSTGRES=false
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=<local-dev-secret>

# --- Optional seed scope ---
# AKSH_DATA_SCOPE=shared
# AKSH_PRACTICE_ID=practice-demo

# --- Unified app (packages/platform-uk) — marketing + platform on same origin ---
# NEXT_PUBLIC_PLATFORM_URL is no longer required; all routes are relative.

# Neon project: Aksh Health (floral-salad-21467299)
# Run seed: cd packages/platform-uk && npm run data:seed:postgres
