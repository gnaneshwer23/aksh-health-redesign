# Aksh Health UK Platform — environment variables
# Copy to packages/platform-uk/.env.local for local development.
# NEVER commit .env.local or real secrets to git.

# --- Auth (NextAuth + Neon Postgres) ---
# NEXTAUTH_URL=https://0ne-health.vercel.app
# NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>
# AKSH_AUTH_PROOF_MODE=true
# AKSH_DEMO_PASSWORD=demo123
# AKSH_DEMO_PASSWORD_HASH=<bcrypt hash; optional override>
# CLINICAL_OAUTH_ENABLED=false
# CLINICAL_OAUTH_CLIENT_ID=
# CLINICAL_OAUTH_CLIENT_SECRET=
# CLINICAL_OAUTH_AUTHORIZATION_URL=
# CLINICAL_OAUTH_TOKEN_URL=

# Seed demo auth users: npm run auth:seed
# Demo password for all accounts: demo123 (override with AKSH_DEMO_PASSWORD)
#
# | Role       | Email                        | Dashboard              |
# |------------|------------------------------|------------------------|
# | GP         | doctor@akshhealth.com        | /dashboard/gp          |
# | GP         | gp@demo.akshhealth.com         | /dashboard/gp          |
# | Nurse      | nurse@demo.akshhealth.com      | /dashboard/nurse       |
# | Pharmacist | pharmacist@demo.akshhealth.com | /dashboard/pharmacist  |
# | Admin      | admin@demo.akshhealth.com      | /dashboard/admin       |
# | ICS Lead   | ics@demo.akshhealth.com        | /dashboard/ics         |
# | Hospital   | hospital@demo.akshhealth.com   | /dashboard/hospital    |
# | Patient    | patient@demo.akshhealth.com    | /dashboard/patient     |
# | Researcher | researcher@demo.akshhealth.com | /dashboard/researcher  |

# --- Local development (.env.local) ---
# DATABASE_URL=postgresql://...@...neon.tech/neondb?sslmode=require
# USE_POSTGRES=false
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=<local-dev-secret>

# --- Optional seed scope ---
# AKSH_DATA_SCOPE=shared
# AKSH_PRACTICE_ID=practice-demo

# --- Unified app (packages/platform-uk) — marketing + platform on same origin ---
# NEXT_PUBLIC_PLATFORM_URL is no longer required; all routes are relative.
# NEXT_PUBLIC_AKSH_ACCESS_REQUEST_MOCK_FALLBACK=true  # show sample organisation enquiries when DB is empty
# NEXT_PUBLIC_AKSH_PILOT_MOCK_FALLBACK=true  # deprecated alias for ACCESS_REQUEST_MOCK_FALLBACK

# Neon project: Aksh Health (floral-salad-21467299)
# Run seed: cd packages/platform-uk && npm run data:seed:postgres

# --- Neo4j AuraDB (Phase 11 — ORACLE / GUARDIAN / ICS graph) ---
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=<aura-generated-password>
# Run seed: npm run data:seed:neo4j
# See docs/NEO4J_SETUP.md
