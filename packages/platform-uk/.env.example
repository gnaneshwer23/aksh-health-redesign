# Aksh Health UK Platform — environment variables
# Copy to packages/platform-uk/.env.local for local development.
# NEVER commit .env.local or real secrets to git.

# --- Auth (NextAuth + Neon Postgres) ---
# NEXTAUTH_URL=https://0ne-health.vercel.app
# NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>
# AKSH_AUTH_PROOF_MODE=true
# CLINICAL_OAUTH_ENABLED=false
# CLINICAL_OAUTH_CLIENT_ID=
# CLINICAL_OAUTH_CLIENT_SECRET=
# CLINICAL_OAUTH_AUTHORIZATION_URL=
# CLINICAL_OAUTH_TOKEN_URL=

# Ensure auth tables exist: npm run auth:schema
# Users must create accounts via /signup — demo credentials were removed.

# E2E / smoke (optional — Playwright creates users via /api/auth/signup when DATABASE_URL is set)
# E2E_TEST_PASSWORD=E2eTestPass1!
# E2E_DATABASE_URL=postgresql://...@...neon.tech/neondb?sslmode=require
#   GitHub Actions secret only — locally use DATABASE_URL instead.
# SMOKE_GP_EMAIL=
# SMOKE_GP_PASSWORD=
# --- Local development (.env.local) ---
# DATABASE_URL=postgresql://...@...neon.tech/neondb?sslmode=require
# Use sslmode=require for Neon/Vercel production. Do not add channel_binding=require —
# it can trigger Node pg SSL warnings on serverless. Optional overrides:
# PGSSLMODE=disable          # local Docker Postgres only
# PGSSL_REJECT_UNAUTHORIZED=true  # stricter cert verification (default: false for managed Neon)
# USE_POSTGRES=false
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=<local-dev-secret>

# --- Optional seed scope ---
# AKSH_DATA_SCOPE=shared
# AKSH_PRACTICE_ID=practice-demo

# --- Unified app (packages/platform-uk) — marketing + platform on same origin ---
# NEXT_PUBLIC_PLATFORM_URL is no longer required; all routes are relative.
# NEXT_PUBLIC_AKSH_ACCESS_REQUEST_MOCK_FALLBACK=true  # show sample organisation enquiries when DB is empty
# NEXT_PUBLIC_AKSH_PILOT_MOCK_FALLBACK=true  # deprecated alias for ACCESS_REQUEST_MOCK_FALLBACK

# Neon project: Aksh Health (floral-salad-21467299)
# Run seed: cd packages/platform-uk && npm run data:seed:postgres

# --- Neo4j AuraDB (Phase 11 — ORACLE / GUARDIAN / ICS graph) ---
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=<aura-generated-password>
# NEO4J_DATABASE=neo4j  # optional — only needed for non-default database names (e.g. AuraDB Professional)
# Run seed: npm run data:seed:neo4j
# See docs/NEO4J_SETUP.md

# --- Transactional email (Resend or SMTP) ---
# RESEND_API_KEY=re_...
# EMAIL_FROM=Aksh Health <noreply@akshhealth.com>
# ACCESS_REQUEST_NOTIFY_EMAIL=team@akshhealth.com
# SKIP_EMAIL_SEND=true  # E2E/CI: skip send and auto-verify signup emails

# --- Optional error monitoring ---
# SENTRY_DSN=  # Optional. Structured errors log via lib/monitoring.ts; add @sentry/nextjs for full SDK

# --- Marketing chatbot (Ask Aksh Health) ---
# Uses Vercel AI Gateway (default provider in the AI SDK). Server-side only — never expose in NEXT_PUBLIC_*.
# AI_GATEWAY_API_KEY=  # Required locally. On Vercel, OIDC may authenticate without this key.
# Without a key (and off Vercel), /api/chat returns 503 and the widget points visitors to FAQ / Contact.

# --- Clinical LLM SYNTHESIS (HITL drafts only) ---
# ENABLE_LLM_SYNTHESIS=true   # default on when AI Gateway / Vercel is available; set false to force deterministic
# POST /api/agents/synthesis — never writes to EHR
# ENABLE_LLM_GUARDIAN=true    # same AI Gateway gate as SYNTHESIS; set false to force deterministic GUARDIAN
# POST /api/agents/guardian — never writes to EHR

# --- Deepgram voice (optional) ---
# DEEPGRAM_API_KEY=
# Without the key, /api/transcribe returns a clearly labelled simulated transcript.

# --- Neo4j (optional graph) ---
# NEO4J_REQUIRED=false  # when false, unreachable Neo4j does not mark /api/health as degraded

# --- EMIS partner track (scaffold only — no live write-back) ---
# EMIS_PARTNER_CLIENT_ID=
# EMIS_PARTNER_CLIENT_SECRET=
# EMIS_PARTNER_TOKEN_URL=
# EMIS_PARTNER_FHIR_BASE_URL=

# npm run auth:cleanup-demo
# npm run auth:cleanup-demo -- --apply
