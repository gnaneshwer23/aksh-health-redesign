# Copy to .env.local for local development. Do not commit secrets.

# Neon Postgres (primary database)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
POSTGRES_DSN=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Service URLs (local defaults)
IDENTITY_CONSENT_URL=http://localhost:8003
INGESTION_API_URL=http://localhost:8001
AI_SAFETY_API_URL=http://localhost:8002

# Optional local infra (when not using Neon for graph/events)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- India Phase 0 placeholders (DPDPA / ABDM / Practo) ---
# Data residency target — all PHI must stay in ap-south-1 before live pilot
AWS_REGION=ap-south-1
DPDPA_REGION=ap-south-1
DPDPA_DEFAULT_RETENTION_DAYS=90
DPDPA_DPO_CONTACT=REPLACE_ME@akshhealth.in

# ABHA / ABDM NHA sandbox (no keys until founder provides)
ABHA_SANDBOX_BASE_URL=https://sandbox.abdm.gov.in
ABHA_CLIENT_ID=REPLACE_ME
ABHA_CLIENT_SECRET=REPLACE_ME

# Practo sandbox (partnership required — E11)
PRACTO_SANDBOX_BASE_URL=https://sandbox-api.practo.example/v1
PRACTO_SANDBOX_CLIENT_ID=REPLACE_ME
PRACTO_SANDBOX_CLIENT_SECRET=REPLACE_ME

